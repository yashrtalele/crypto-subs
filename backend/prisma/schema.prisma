generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id               String             @id
  username         String             @unique
  email            String             @unique
  bio              String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  SubscriptionTier SubscriptionTier[]
}

model Fan {
  id           String         @id
  username     String         @unique
  email        String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  Subscription Subscription[]
}

model PaymentInfo {
  id             String       @id
  subscriptionId String
  transactionId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model Payout {
  id               String           @id
  tierId           String
  amount           Float
  payoutStatus     PaymentStatus
  payoutDate       DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  SubscriptionTier SubscriptionTier @relation(fields: [tierId], references: [id])
}

model Subscription {
  id               String           @id
  fanId            String
  tierId           String
  paymentStatus    PaymentStatus
  expiration       DateTime
  subscriptionDate DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  PaymentInfo      PaymentInfo[]
  Fan              Fan              @relation(fields: [fanId], references: [id])
  SubscriptionTier SubscriptionTier @relation(fields: [tierId], references: [id])
}

model SubscriptionTier {
  id             String         @id
  name           String
  creatorId      String
  price          Float
  perks          String[]
  duration       Int
  subscribers    Int
  monthlyRevenue Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  description    String
  tier           Int
  Payout         Payout[]
  Subscription   Subscription[]
  Creator        Creator        @relation(fields: [creatorId], references: [id])
}

enum PaymentStatus {
  COMPLETED
  PENDING
}
